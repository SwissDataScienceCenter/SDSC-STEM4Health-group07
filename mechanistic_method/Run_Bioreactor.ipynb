      "source": [
        "from pathlib import Path\n",
        "from zipfile import ZipFile\n",
        "import io\n",
        "import json\n",
        "import subprocess\n",
        "import sys\n",
        "\n",
        "MODE = \"regenerate\"  # Choose \"regenerate\" or \"retrain\" here.\n",
        "\n",
        "if MODE not in {\"regenerate\", \"retrain\"}:\n",
        "    raise ValueError('MODE must be \"regenerate\" or \"retrain\".')\n",
        "if sys.version_info < (3, 11):\n",
        "    raise RuntimeError(\"Please use Python 3.11 or newer for this package.\")\n",
        "\n",
        "try:\n",
        "    from google.colab import files as colab_files\n",
        "except ImportError:\n",
        "    colab_files = None\n",
        "\n",
        "def find_project():\n",
        "    for candidate in (Path.cwd(), Path.cwd() / \"bioreactor_ready_to_run\"):\n",
        "        required = (\"run.py\", \"requirements.txt\", \"lab/common.py\")\n",
        "        if all((candidate / name).is_file() for name in required):\n",
        "            return candidate.resolve()\n",
        "    return None\n",
        "\n",
        "ROOT = find_project()\n",
        "if ROOT is None and colab_files is not None:\n",
        "    print(\"Upload bioreactor_ready_to_run.zip.\")\n",
        "    uploaded = colab_files.upload()\n",
        "    archives = [(name, data) for name, data in uploaded.items()\n",
        "                if name.lower().endswith(\".zip\")]\n",
        "    if len(archives) != 1:\n",
        "        raise ValueError(\"Please upload exactly one project ZIP file.\")\n",
        "    destination = Path.cwd().resolve()\n",
        "    with ZipFile(io.BytesIO(archives[0][1])) as archive:\n",
        "        expected = {\n",
        "            \"bioreactor_ready_to_run/run.py\",\n",
        "            \"bioreactor_ready_to_run/requirements.txt\",\n",
        "            \"bioreactor_ready_to_run/lab/common.py\",\n",
        "        }\n",
        "        if not expected.issubset(set(archive.namelist())):\n",
        "            raise ValueError(\"This ZIP does not contain the expected project folder.\")\n",
        "        for member in archive.infolist():\n",
        "            target = (destination / member.filename).resolve()\n",
        "            if not target.is_relative_to(destination / \"bioreactor_ready_to_run\"):\n",
        "                raise ValueError(\"The ZIP contains a path outside the project folder.\")\n",
        "            if (member.external_attr >> 16) & 0o170000 == 0o120000:\n",
        "                raise ValueError(\"The ZIP contains an unsupported symbolic link.\")\n",
        "        archive.extractall(destination)\n",
        "    ROOT = find_project()\n",
        "\n",
        "if ROOT is None:\n",
        "    raise FileNotFoundError(\n",
        "        \"Extract bioreactor_ready_to_run.zip, then open this notebook inside \"\n",
        "        \"the bioreactor_ready_to_run folder and run this cell again.\"\n",
        "    )\n",
        "\n",
        "print(\"Project folder:\", ROOT)\n",
        "print(\"Selected mode:\", MODE)\n"
      ]
    },
