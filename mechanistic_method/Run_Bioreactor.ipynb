      "source": [
        "import pandas as pd\n",
        "from IPython.display import FileLink, display\n",
        "\n",
        "with (OUTPUTS / \"validation.json\").open(encoding=\"utf-8\") as handle:\n",
        "    validation = json.load(handle)\n",
        "print(\"Output validation:\")\n",
        "print(json.dumps(validation, indent=2))\n",
        "\n",
        "submission = pd.read_csv(OUTPUTS / \"submission_best.csv\", dtype={\"batch_id\": str})\n",
        "print(\"Submission rows:\", len(submission))\n",
        "display(submission.head())\n",
        "\n",
        "filenames = [\n",
        "    \"submission_best.csv\",\n",
        "    \"submission_nosearch.csv\",\n",
        "    \"submission_mechanistic_blend.csv\",\n",
        "]\n",
        "for filename in filenames:\n",
        "    output_file = OUTPUTS / filename\n",
        "    if not output_file.is_file():\n",
        "        raise FileNotFoundError(f\"Expected output is missing: {output_file}\")\n",
        "    if colab_files is not None:\n",
        "        colab_files.download(str(output_file))\n",
        "    else:\n",
        "        display(FileLink(str(output_file.relative_to(Path.cwd()))))\n"
      ]
    }
